{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qraft Academy Content Schema",
  "type": "object",
  "properties": {
    "visionBlock": {
      "type": "object",
      "properties": {
        "slogan": { "type": "string" },
        "statement": { "type": "string" },
        "subheading": { "type": "string" },
        "heroMedia": { "type": "object" }
      },
      "required": ["slogan", "statement", "subheading"]
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "icon": { "type": "string" },
          "relatedGoals": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "name"]
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "owner": { "type": "string" },
          "dueDate": { "type": "string", "format": "date" },
          "status": { "type": "string" },
          "objectives": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "metric": { "type": "string" },
                "target": { "type": ["number", "string"] },
                "current": { "type": ["number", "string"] },
                "unit": { "type": "string" },
                "owner": { "type": "string" },
                "dueDate": { "type": "string", "format": "date" },
                "status": { "type": "string" }
              },
              "required": ["id", "title"]
            }
          }
        },
        "required": ["id", "title"]
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string" },
          "productLinks": { "type": "array", "items": { "type": "string" } },
          "owner": { "type": "string" },
          "impact": { "type": "object" }
        },
        "required": ["id", "date", "description"]
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "year": { "type": "integer" },
          "metric": { "type": "string" },
          "value": {},
          "narrative": { "type": "string" },
          "beneficiaries": { "type": "integer" }
        },
        "required": ["id", "title", "year"]
      }
    },
    "communities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "focusAreas": { "type": "array", "items": { "type": "string" } },
          "events": { "type": "array" }
        },
        "required": ["id", "name"]
      }
    },
    "lastUpdated": { "type": "string", "format": "date-time" }
  },
  "required": ["visionBlock", "products", "goals", "milestones", "achievements", "lastUpdated"]
}
